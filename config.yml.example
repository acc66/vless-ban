# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# ── Anti-probe guard (vless/vmess/trojan + ws, ss + v2ray-plugin websocket; non-TLS only) ──
# Wrong ws path → IP banned + nginx honeypot page; banned IPs are dropped on connect.
# guard:
#   enabled: true
#   blacklist: "/etc/xboard-node/blacklist.txt"  # one IP per line, delete a line to unban
#   allow: "1.2.3.4"                              # never ban these (your own test IPs)
#   real_ip_header: ""                            # e.g. "CF-Connecting-IP" ONLY if the port is CDN-only
#   no_ban: false                                 # true = honeypot only, no banning
